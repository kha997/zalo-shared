# syntax=docker/dockerfile:1
# Separate, intentionally SDK-bearing pilot connector image.
# The application image (ops/Dockerfile) stays SDK-free; this image is never
# the default deployment and publishes no ports.
ARG BUILDER_IMAGE=node:24.19.0-bookworm-slim@sha256:a9f5f7c91a432850b2a8a7797adf5eadb6c733ceed61167806cee7ea7fbc29df
ARG RUNTIME_IMAGE=gcr.io/distroless/nodejs24-debian13@sha256:cb606325b7ec4af55462cb0b424a53b452a5b4a894ffe841fcf1048d216fb9f8

FROM ${BUILDER_IMAGE} AS build
WORKDIR /app
COPY package.json package-lock.json tsconfig.json tsconfig.connector.json ./
RUN --mount=type=secret,id=proxy_ca \
    if [ -f /run/secrets/proxy_ca ]; then export NODE_EXTRA_CA_CERTS=/run/secrets/proxy_ca; fi; \
    npm ci --ignore-scripts --strict-ssl=true
COPY server ./server
COPY adapters ./adapters
COPY tools ./tools
RUN ./node_modules/.bin/tsc -p tsconfig.connector.json

# Runtime dependencies come only from the dedicated connector lock. The root
# development tree is never copied or pruned into this image.
FROM ${BUILDER_IMAGE} AS runtime-deps
WORKDIR /app/connector
COPY connector/package.json connector/package-lock.json ./
RUN --mount=type=secret,id=proxy_ca \
    if [ -f /run/secrets/proxy_ca ]; then export NODE_EXTRA_CA_CERTS=/run/secrets/proxy_ca; fi; \
    npm ci --omit=dev --ignore-scripts --strict-ssl=true

FROM ${RUNTIME_IMAGE}
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build --chown=65532:65532 /app/dist/connector ./dist/connector
COPY --from=runtime-deps --chown=65532:65532 /app/connector/node_modules ./node_modules
COPY --from=runtime-deps --chown=65532:65532 /app/connector/package.json ./package.json
USER 65532:65532
# No EXPOSE: the pilot connector serves no HTTP endpoint. Dry-run fails closed
# without a private manifest and never reads the vault, imports the SDK, or
# touches the database or network.
CMD ["dist/connector/tools/pilot-connector.js", "dry-run"]
