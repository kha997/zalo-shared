# TEMPLATE ONLY. Copy outside repository, chmod 600; replace every empty value.
# URL-encode password in DATABASE_URL. PG hostname is postgres inside Compose.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
# Runtime URL uses zs_app; owner URL is only for one-off migrations/seed.
APP_DATABASE_PASSWORD=
APP_DATABASE_ROLE=zs_app
MIGRATION_DATABASE_URL=
DATABASE_URL=
PUBLIC_ORIGIN=http://127.0.0.1:3100
METRICS_TOKEN=
# Supply only to the one-off seed process, never keep in container runtime config.
ADMIN_EMAIL=
ADMIN_PASSWORD=
