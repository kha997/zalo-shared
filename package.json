{
  "name": "zalo-shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch server/main.ts",
    "dev:client": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && npm run build:server",
    "typecheck": "tsc --noEmit",
    "start": "node dist/server/main.js",
    "worker": "tsx server/worker.ts",
    "migrate": "tsx server/migrate.ts",
    "seed": "tsx server/seed.ts",
    "test": "node --import tsx --test --test-isolation=none --test-concurrency=1 tests/backend/*.test.ts tests/transport/*.test.ts",
    "test:e2e": "playwright test",
    "test:load": "tsx tests/load/run.ts",
    "test:transport": "node --import tsx --test --test-isolation=none tests/transport/*.test.ts",
    "build:server": "tsc -p tsconfig.server.json",
    "start:worker": "node dist/server/worker.js",
    "test:sdk": "node --permission --allow-fs-read=./node_modules --allow-fs-read=./package.json --allow-fs-read=./tests/fixtures/sdk-offline-probe.mjs --allow-fs-read=./adapters/zalo/transport.ts --allow-fs-read=./adapters/zalo/media.ts --allow-fs-read=./server/media.ts tests/fixtures/sdk-offline-probe.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "fastify": "^5.6.0",
    "ipaddr.js": "2.5.0",
    "pg": "^8.16.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "zca-js": "2.2.0"
  }
}
